@import('mixins/reset.styl')
@import('mixins/markdown.styl')

mq-mobile = "screen and (max-width: 479px)"

[data-color-mode*='dark'], [data-color-mode*='dark'] body {
  color-scheme: dark;
  --color-header-bg: #3a3a3a8f;
  --color-header-border: #323232;
  --color-hover: #ffffff30;
}
[data-color-mode*='light'], [data-color-mode*='light'] body {
  color-scheme: light;
  --color-header-bg: #ffffff52;
  --color-header-border: #d3d3d3;
  --color-hover: #f2f2f2;
}

/* 现代亮暗切换按钮 */
#theme-toggle
  position fixed
  left 14px
  top 12px
  z-index 999
  width 36px
  height 36px
  border-radius 50%
  border none
  background transparent
  display flex
  align-items center
  justify-content center
  cursor pointer
  padding 0
  transition background 0.25s ease
  color currentColor
  outline none
  &:hover
    background rgba(128,128,128,0.18)
  svg
    display block
    pointer-events none

.warpper {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  .footer {
    padding-bottom: 60px;
  }
}

.header {
  width 517px
  margin 0 auto 0
  padding 0 10px
  .logo a {
    display flex
    color: currentColor;
  }
  .box {
    position relative
  }
  .search {
    min-height 20px
    position relative
    display flex
    align-items stretch
    li,ul {
      list-style none
    }
    #result {
      .ok {
        background:#f4f4f4;
      }
    }
    .search-list {
      position absolute
      display none
      z-index 999
      box-shadow 1px 1px 3px var(--color-theme-bg)
      border 1px solid var(--color-header-border)
      background var(--color-theme-bg)
      min-width 100px
      top 52px
      width 100%
      padding 5px
      border-radius 12px
      li {
        line-height 23px
        span{
          padding 0 8px
          color #b9b9b9
        }
      }
      a {
        display block
        padding 2px 6px 2px 6px
        &:hover {
          background-color var(--color-hover)
        }
        .kw {
          color #f00
          font-style inherit
          font-weight bold
        }
      }
    }
    .query {
      flex 1
      min-width 0
      resize: none;
      position relative
      z-index 2
      height 46px
      padding 0 16px
      font-size 15px
      font-weight normal
      line-height 46px
      background-color: transparent;
      background-image none
      border none
      border-radius 24px 0 0 24px
      -webkit-appearance: none;
      outline none
      box-shadow: 0 0 0 2px #4e6ef2 inset;
      transition box-shadow 0.2s ease
      &:focus {
        z-index 99
        outline 0
        box-shadow: 0 0 0 2px #4e6ef2 inset, 0 4px 16px rgba(78,110,242,0.15);
      }
    }
    .enter-input {
      flex-shrink 0
      display flex
      align-items stretch
      button {
        display flex
        align-items center
        justify-content center
        height 46px
        padding 0 26px
        font-size 15px
        font-weight bold
        white-space nowrap
        cursor pointer
        user-select none
        border none
        outline none
        border-radius 0 24px 24px 0
        background linear-gradient(135deg, #4e6ef2 0%, #8b5cf6 100%)
        color #fff
        letter-spacing 0.5px
        transition all 0.2s ease
        box-shadow: -2px 0 0 0 #4e6ef2;
        &:hover {
          background linear-gradient(135deg, #3d5de0 0%, #7c4fe0 100%)
          box-shadow: -2px 0 0 0 #3d5de0, 0 4px 12px rgba(78,110,242,0.35);
        }
        &:active {
          transform scale(0.97)
        }
      }
    }
  }
}

.footer
  text-align center
  font-size 13px
  font-weight 300
  border-top 1px solid var(--color-header-border)
  padding 24px 6px 40px 6px
  color #888
  &.home
    border-top 0
  div
    font-size 13px
    margin-top 6px
  a
    color inherit
    opacity 0.75
    &:hover
      opacity 1

.header.home {
  .header_inner {
    display flex
    flex-direction column
    align-items center
  }
  .logo {
    min-height 140px
    display flex
    align-items center
  }
  .search {
    display flex
    width 280px
    transition width 0.35s cubic-bezier(0.4,0,0.2,1)
    &:focus-within {
      width 420px
    }
  }
}

.header.header_list {
  width auto
  position fixed
  width 100%
  background var(--color-theme-bg)
  backdrop-filter saturate(180%) blur(0.4rem)
  background-color var(--color-header-bg)
  z-index 99
}

.header_list
  padding 10px 10px 10px 13px
  border-bottom 1px solid var(--color-header-border)
  .logo
    padding-right 20px
    flex-shrink 0
    display flex
    align-items center
    a
      display flex
      align-items center
      text-decoration none
      &:hover
        opacity 1
    svg
      width 32px
      height 32px
      flex-shrink 0

.search_list {
  padding 79px 27px 
  a {
    font-size 16px
    strong {
      font-weight bold
    }
    .kw {
      color #f00
      font-style inherit
      font-weight bold
    }
    &:hover {
      .kw {
        color #333
      }
    }
  }
  li {
    padding 10px 0 10px 0
    list-style-type none
    p {
      padding-top 5px
      color #4F4F4F
    }
  }
}

.hotlist {
  padding 79px 27px 
  a {
    font-size 16px
    strong {
      font-weight bold
    }
  }
  li {
    padding 5px 0 5px 0
    list-style-type none
    p{
      padding-top 5px
      color #4F4F4F
    }
  }
}

.header_list .header_inner {
  display: flex;
  align-items: center;
  .search {
    display: flex;
    width 260px
    max-width 100%
    transition width 0.35s cubic-bezier(0.4,0,0.2,1)
    &:focus-within {
      width 460px
    }
  }
}

.header_inner, .hotlist, .search_list, .contributors {
  max-width 920px
  margin 0 auto
}

.contributors {
  padding 79px 27px
  max-width: 960px;
  font-family: -apple-system,BlinkMacSystemFont,"Segoe UI",Helvetica,Arial,sans-serif,"Apple Color Emoji","Segoe UI Emoji";
  font-size: 16px;
  line-height: 1.5;
  word-wrap: break-word;
  a {
    font-weight: bold;
  }
  .links {
    display: inline-flex;
    flex-wrap: wrap;
  }
  .links a {
    background: var(--color-theme-bg);
    height: 2.1rem;
    border-radius: 0.3rem;
    gap: 0.1rem;
    padding: 0rem 0.5rem 0rem 0.4rem;
  }
}

@media mq-mobile {
  /* 移动端固定暗色切换按钮位置，避免与logo重叠 */
  #theme-toggle {
    left 8px
    top 8px
    width 32px
    height 32px
  }

  .header {
    width inherit
    .search .enter-input {
      button {
        padding 9px 14px
      }
    }
  }

  .header_list {
    padding 10px 10px 10px 13px
    .logo {
      float inherit
      padding-right 10px
      padding-left 36px  /* 为暗色切换按钮留出空间 */
      text-align center
      svg {
        width 96px
      }
    }
    .search {
      /* 移动端禁用搜索框伸缩效果，保持最小宽度 */
      width 100% !important
      &:focus-within {
        width 100% !important
      }
      .query {
        line-height 31px
      }
    }
  }

  .search_list, .hotlist {
    padding 78px 27px
  }
}
<div class="header<%if(type=='list'){%> header_list<%}%><%if(type=='home'){%> home<%}%>">
  <div class="header_inner">
      <%if(type!='home'){%>
      <div class="logo">
        <a href="<%=relative_path%>" title="返回首页">
          <img src="<%=relative_path%>img/linux.svg" width="36" height="36" alt="Linux" />
        </a>
      </div>
      <div class="search">
          <ul class="search-list" id="result">
          </ul>
          <input type="text" class="query" id="query" autocomplete="off" placeholder="Linux 命令搜索"/>
          <div class="enter-input">
              <input type="hidden" id="current_path" value="<%=current_path%>">
              <button id="search_btn">搜索</button>
          </div>
      </div>
      <%}%>
      <%if(type=='home'){%>
      <!-- AI/Human 切换按钮 -->
      <div class="mode-switcher">
        <button class="mode-btn active" data-mode="human" onclick="switchMode('human')">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
          <span>我是 Human</span>
        </button>
        <button class="mode-btn" data-mode="ai" onclick="switchMode('ai')">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="11" width="18" height="10" rx="2"></rect>
            <circle cx="12" cy="5" r="2"></circle>
            <path d="M12 7v4"></path>
            <line x1="8" y1="16" x2="8" y2="16"></line>
            <line x1="16" y1="16" x2="16" y2="16"></line>
          </svg>
          <span>我是 AI</span>
        </button>
      </div>

      <!-- Human 模式：搜索框 -->
      <div class="search" id="human-mode">
          <ul class="search-list" id="result">
            <!-- <li><a href="#"><strong>find</strong> - 指定目录下查找文件。</a></li> -->
          </ul>
          <input type="text" class="query" id="query" autocomplete="off" autofocus="autofocus" placeholder="Linux 命令搜索"/>
          <div class="enter-input">
              <input type="hidden" id="current_path" value="<%=current_path%>">
              <button id="search_btn">搜索</button>
          </div>
      </div>

      <!-- AI 模式：API 文档 -->
      <div class="api-docs" id="ai-mode" style="display: none;">
        <div class="api-card">
          <div class="api-header">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="16 18 22 12 16 6"></polyline>
              <polyline points="8 6 2 12 8 18"></polyline>
            </svg>
            <h3>Linux Command API</h3>
          </div>
          
          <div class="api-intro">
            <p><strong>🌐 Linux 命令速查手册</strong> - 包含 615+ 个 Linux 命令的完整文档，支持智能搜索和结构化数据获取。</p>
          </div>
          
          <button class="copy-all-btn" onclick="copyApiDocs()" title="点击复制发送给我你的agent">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span id="copy-btn-text">点击复制发送给你的agent</span>
          </button>
          
          <table class="api-table">
            <thead>
              <tr>
                <th>接口</th>
                <th>返回格式</th>
                <th>用途</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><code class="api-url" data-path="/api/cmdlist"></code></td>
                <td><span class="badge json">JSON 数组</span></td>
                <td>获取所有命令列表</td>
              </tr>
              <tr>
                <td><code class="api-url" data-path="/api/cmd/search?q=关键词"></code></td>
                <td><span class="badge json">JSON 数组</span></td>
                <td>搜索相关命令</td>
              </tr>
              <tr>
                <td><code class="api-url" data-path="/api/cmd/detailed?name=命令"></code></td>
                <td><span class="badge markdown">Markdown 文本</span></td>
                <td>获取命令完整文档</td>
              </tr>
            </tbody>
          </table>
          <div class="api-tips">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="16" x2="12" y2="12"></line>
              <line x1="12" y1="8" x2="12.01" y2="8"></line>
            </svg>
            <span>点击 URL 可单独复制，或点击上方按钮复制完整文档</span>
          </div>
        </div>
      </div>
      <%}%>
  </div>
</div>

<%if(type=='home'){%>
<script>
function switchMode(mode) {
  // 更新按钮状态
  document.querySelectorAll('.mode-btn').forEach(btn => {
    btn.classList.toggle('active', btn.dataset.mode === mode);
  });
  
  // 切换显示内容
  const humanMode = document.getElementById('human-mode');
  const aiMode = document.getElementById('ai-mode');
  
  if (mode === 'human') {
    humanMode.style.display = 'flex';
    aiMode.style.display = 'none';
  } else {
    humanMode.style.display = 'none';
    aiMode.style.display = 'block';
    // 更新 API URL
    updateApiUrls();
  }
}

function updateApiUrls() {
  const protocol = window.location.protocol;
  const host = window.location.host;
  const baseUrl = `${protocol}//${host}`;
  
  document.querySelectorAll('.api-url').forEach(el => {
    const path = el.dataset.path;
    el.textContent = baseUrl + path;
    el.onclick = function() {
      navigator.clipboard.writeText(baseUrl + path);
      const original = el.textContent;
      el.textContent = '✓ 已复制';
      el.classList.add('copied');
      setTimeout(() => {
        el.textContent = original;
        el.classList.remove('copied');
      }, 1500);
    };
  });
}

function copyApiDocs() {
  const protocol = window.location.protocol;
  const host = window.location.host;
  const baseUrl = `${protocol}//${host}`;
  
  // 所见即所得：直接复制页面上显示的 API 文档
  const apiDocs = `Linux Command API

🌐 Linux 命令速查手册 - 包含 615+ 个 Linux 命令的完整文档，支持智能搜索和结构化数据获取。

接口列表：

1. 获取所有命令列表
   ${baseUrl}/api/cmdlist
   返回格式：JSON 数组
   用途：获取所有命令列表

2. 搜索命令
   ${baseUrl}/api/cmd/search?q=关键词
   返回格式：JSON 数组
   用途：搜索相关命令

3. 获取命令详情
   ${baseUrl}/api/cmd/detailed?name=命令
   返回格式：Markdown 文本
   用途：获取命令完整文档

使用建议：
- 先用 /api/cmdlist 了解有哪些命令
- 用 /api/cmd/search 搜索相关命令
- 用 /api/cmd/detailed 获取完整文档
- 测试一下这个，并生成一个skills。后续碰到不懂的linux命令按照这个skills查询`;
  
  navigator.clipboard.writeText(apiDocs).then(() => {
    const btnText = document.getElementById('copy-btn-text');
    const originalText = btnText.textContent;
    btnText.textContent = '✓ 已复制到剪贴板';
    
    setTimeout(() => {
      btnText.textContent = originalText;
    }, 2000);
  }).catch(err => {
    console.error('复制失败:', err);
    alert('复制失败，请手动复制');
  });
}

// 页面加载时初始化
document.addEventListener('DOMContentLoaded', function() {
  updateApiUrls();
});
</script>
<%}%>
